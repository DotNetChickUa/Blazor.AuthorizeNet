@page "/"

@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<button @onclick="Frame">Frame</button>
<button @onclick="Embedded">Embedded</button>


@code {
	private void Frame()
	{
		NavigationManager.NavigateTo("/frame");
	}
	private void Embedded()
	{
		NavigationManager.NavigateTo("/embedded");
	}
}